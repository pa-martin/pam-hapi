{
  "name": "pam-hapi",
  "version": "0.5.3",
  "description": "Personal API for Home Assistant",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch src -e js,ts,json --exec \"ts-node src/server.ts\"",
    "build": "tsup src/server.ts --format cjs --clean",
    "lint": "eslint .",
    "start": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pa-martin/pam-hapi.git"
  },
  "keywords": [],
